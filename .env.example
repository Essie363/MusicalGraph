# MusicGraph 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# Supabase（在 Supabase 控制台 Settings -> API 获取）
# 用于数据迁移脚本 migrate_supabase.py（service role key 只用于本地，禁止进前端或仓库）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Next.js 前端环境变量（放入 webapp/.env.local，前缀 NEXT_PUBLIC_ 才能暴露给浏览器）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PocketBase（已归档，仅国内云服务器/本地回退时使用；见 archive/pocketbase/README.md）
# 用于 import_pocketbase.py / apply_pocketbase.py 等脚本的管理员登录
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=your-admin@email.com
PB_ADMIN_PASSWORD=your-admin-password

