name: Supabase Keepalive (optional)

# 可选模板：防止 Supabase Free 项目因长时间无访问被挂起。
# 默认禁用（文件名带 .disabled，GitHub 不会运行）。
# 启用步骤：
#   1) 改名为 keepalive.yml
#   2) 在 GitHub 仓库 Secrets 添加 MG_SUPABASE_URL、MG_SUPABASE_ANON_KEY
#   3) 在 Variables 添加 MG_SITE_URL（正式站地址）
#   4) 推送到默认分支，或手动 Run workflow 测试一次
on:
  schedule:
    - cron: "0 2 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping site
        run: curl -fsS --max-time 20 "${{ vars.MG_SITE_URL }}/?mode=online" || true
      - name: Ping Supabase
        run: >
          curl -fsS --max-time 20
          "${{ secrets.MG_SUPABASE_URL }}/rest/v1/relation_types?limit=1"
          -H "apikey: ${{ secrets.MG_SUPABASE_ANON_KEY }}"
          -H "Authorization: Bearer ${{ secrets.MG_SUPABASE_ANON_KEY }}" || true